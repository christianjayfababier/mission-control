{
  "name": "mission-control",
  "productName": "Mission Control",
  "version": "0.2.0",
  "description": "Desktop terminal workspace for Claude Code orchestrators and their worker agents across projects.",
  "main": "main.js",
  "author": "kaiGen_dev",
  "private": true,
  "scripts": {
    "start": "electron .",
    "screenshot": "electron . --screenshot screenshot.png",
    "test": "node test/unit.js && node test/smoke.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kaigen.missioncontrol",
    "productName": "Mission Control",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "christianjayfababier",
      "repo": "mission-control"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "diag.js",
      "checkpoint.js",
      "transcripts.js",
      "integrations.js",
      "boards.js",
      "rules.js",
      "explorer.js",
      "prwatch.js",
      "team.js",
      "providers.js",
      "secrets.js",
      "globalsettings.js",
      "newproject-lib.js",
      "package.json",
      "kit/**",
      "renderer/**",
      "node_modules/**",
      "!test/**",
      "!docs/**",
      "!.github/**",
      "!node_modules/node-pty/prebuilds/**/*.pdb",
      "!*.png",
      "!build/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "**/*.node"
    ],
    "artifactName": "Mission-Control-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Mission Control"
    }
  }
}
